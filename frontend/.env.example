# Vite env vars (copy this file to .env.local)

# Optional: same Web Client ID as OAUTH_GOOGLE_ID. If omitted, /auth reads client ID from GET /api/auth/google-oauth-client-id (backend env only).
# VITE_OAUTH_GOOGLE_ID=

# Map station page uses OpenStreetMap via Leaflet and does not require a map API key.
